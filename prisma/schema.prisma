generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  bio       String?
  avatarUrl String?
  bannerUrl String?
  bannerMode String @default("dynamic")
  createdAt DateTime @default(now())
  resetToken String? @unique
  resetTokenExpiry DateTime?
  
  username            String?  @unique
  location            String?
  website             String?
  twitter             String?
  instagram           String?
  pronouns            String?
  isPrivate           Boolean  @default(false)
  showActivity        Boolean  @default(true)
  twoFactorEnabled    Boolean  @default(false)
  contentSensitivity  Boolean  @default(false)
  isDeactivated       Boolean  @default(false)

  // Profile Privacy Settings
  showWatchlist       Boolean  @default(true)
  showFavorites       Boolean  @default(true)
  showWatchHistory    Boolean  @default(true)
  showRatings         Boolean  @default(true)
  showTVProgress      Boolean  @default(true)
  showAchievements    Boolean  @default(true)
  showFollowedPeople  Boolean  @default(true)
  showJoinDate        Boolean  @default(true)
  showLocation        Boolean  @default(true)
  showSocialLinks     Boolean  @default(true)

  // External Integration Tokens
  traktToken          String?
  traktRefreshToken   String?
  letterboxdToken     String?
  letterboxdRefreshToken String?
  malToken            String?
  malRefreshToken     String?
  simklToken          String?
  simklRefreshToken   String?
  discordId           String?
  discordToken        String?
  discordRefreshToken String?

  watched   Watched[]
  watchlist       Watchlist[]
  favorites       Favorite[]
  watchedEpisodes WatchedEpisode[]
  collections     Collection[]
  achievements    UserAchievement[]
  followedPeople  FollowedPerson[]
  customPosters   CustomPoster[]
  watchedMatches  WatchedMatch[]
}

model Watched {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    String
  mediaType String   // "movie" | "tv"
  title     String
  poster    String?
  rating    Int?
  review    String?
  runtime   Int?
  watchedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    String
  mediaType String   // "movie" | "tv"
  title     String
  poster    String?
  addedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    String
  mediaType String   // "movie" | "tv"
  title     String
  poster    String?
  addedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
}

model WatchedEpisode {
  id            String   @id @default(cuid())
  userId        String
  tmdbId        String   // The ID of the TV Show
  seasonNumber  Int
  episodeNumber Int
  runtime       Int?
  watchedAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, seasonNumber, episodeNumber])
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       CollectionItem[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CollectionItem {
  id        String   @id @default(cuid())
  collectionId String
  tmdbId    String
  mediaType String   // "movie" | "tv" | "person"
  title     String
  poster    String?
  addedAt   DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  @@unique([collectionId, tmdbId, mediaType])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model FollowedPerson {
  id          String   @id @default(cuid())
  userId      String
  tmdbId      String
  name        String
  profilePath String?
  job         String   @default("Director")
  followedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
}

model CustomPoster {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    String
  mediaType String   // "movie" | "tv"
  posterUrl String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
}

model WatchedMatch {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  sport     String
  title     String
  team1     String
  team2     String
  score     String?
  watchedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
}
